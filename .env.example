# Supabase — obtén estos valores en: tu-proyecto.supabase.co → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Para el keepalive de GitHub Actions, agrega los mismos valores
# como secrets en: Repo → Settings → Secrets → Actions:
#   SUPABASE_URL    (mismo que VITE_SUPABASE_URL)
#   SUPABASE_ANON_KEY (mismo que VITE_SUPABASE_ANON_KEY)
