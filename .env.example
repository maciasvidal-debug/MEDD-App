# Supabase — obtén estos valores en: tu-proyecto.supabase.co → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Para el keepalive de GitHub Actions, agrega los mismos valores
# como secrets en: Repo → Settings → Secrets → Actions:
#   SUPABASE_URL    (mismo que VITE_SUPABASE_URL)
#   SUPABASE_ANON_KEY (mismo que VITE_SUPABASE_ANON_KEY)

# ── Backend Express (autenticación de JWT de Supabase) ───────────────
# El backend valida el token del usuario en cada request. Con llaves de
# firma asimétricas (predeterminado actual de Supabase) basta con la URL;
# las llaves públicas se obtienen del endpoint JWKS del proyecto.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Solo si tu proyecto usa el secreto JWT heredado (HS256). Settings → API
# → JWT Settings → JWT Secret. Déjalo vacío si usas llaves asimétricas.
SUPABASE_JWT_SECRET=

# Conexión a Postgres del backend (cadena de Supabase: Settings → Database).
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Pon PGSSL=false solo en desarrollo local sin TLS.
# PGSSL=false

# Puerto del API y orígenes permitidos por CORS (coma-separados).
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Límites opcionales: tamaño de body JSON y rate limiting.
# JSON_LIMIT=100kb
# RATE_LIMIT_MAX=300
# WRITE_RATE_LIMIT_MAX=30
